{
  // Open the project through this file. It holds only what belongs to the workspace as a whole: the folder
  // and how VS Code shows and watches its files. Everything tied to the code lives in .vscode/ (settings.json
  // for Python, tasks.json, launch.json, extensions.json), so no key is defined in both places.
  "folders": [
    {
      "name": "PyVideoKit",
      "path": "."
    }
  ],
  "settings": {
    // arch/PKGBUILD is the bash script makepkg reads.
    "files.associations": {
      "**/PKGBUILD": "shellscript"
    },
    // Bytecode and setuptools metadata (packages/*/src/*.egg-info, PyVideoKit.egg-info at the root).
    // Search already skips these and everything in .gitignore, so there is no search.exclude.
    "files.exclude": {
      "**/__pycache__": true,
      "**/*.egg-info": true
    },
    // Large generated trees: the venv, python -m build output, make build-* (PKGs/) and makepkg in arch/.
    "files.watcherExclude": {
      "**/.venv/**": true,
      "**/build/**": true,
      "**/dist/**": true,
      "**/PKGs/**": true,
      "**/arch/src/**": true,
      "**/arch/pkg/**": true,
      "**/arch/PyVideoKit/**": true
    }
  }
}
